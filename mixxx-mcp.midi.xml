<?xml version="1.0" encoding="utf-8"?>
<!--
  mixxx-mcp.midi.xml - Mixxx controller preset for mixxx-mcp

  Install: copy to %LOCALAPPDATA%\Mixxx\controllers\ (Windows)
           or ~/.mixxx/controllers/ (Linux)

  Every CC 0-127 on channel 1 (status 0xB0) is delegated to MixxxMCP.handleCC(),
  which routes it via the CC_ROUTE table in mixxx-mcp.js.

  Note: with <script-binding/>, <key> must name the JS function to invoke -
  it is not a Mixxx control name. The group is passed through to the handler,
  which ignores it and resolves the real target from CC_ROUTE.
-->
<MixxxControllerPreset mixxxVersion="2.4" schemaVersion="1">
    <info>
        <name>mixxx-mcp</name>
        <author>mixxx-mcp</author>
        <description>MCP (Model Context Protocol) server bridge - allows AI agents and automation to control Mixxx via virtual MIDI port. Requires mixxx-mcp Python server running.</description>
        <wiki>https://github.com/cloudygetty-ai/mixxx-mcp</wiki>
        <forums></forums>
    </info>
    <controller id="mixxx-mcp">
        <scriptfiles>
            <file filename="mixxx-mcp.js" functionprefix="MixxxMCP"/>
        </scriptfiles>
        <controls>
            <control>
